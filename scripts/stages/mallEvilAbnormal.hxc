import flixel.util.FlxSave;
import funkin.play.stage.Stage;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.ui.FullScreenScaleMode;

class mallEvilAbnormalStage extends Stage {
	function new() {
		super('mallEvilabnormal');
		save = new FlxSave();
		save.bind("SpookyMixOptions", "FunkinCrew");
	}

	var colorShaderBf:AdjustColorShader;
	var colorShaderDad:AdjustColorShader;

	function buildStage() {
		super.buildStage();

		colorShaderBf = new AdjustColorShader();
		colorShaderDad = new AdjustColorShader();

		if (save.data.spookyShaders != false) {
			colorShaderBf.brightness = -48;
			colorShaderBf.contrast = 28;
			colorShaderBf.saturation = -18;
			colorShaderBf.hue = -29;

			colorShaderDad.brightness = -28;
			colorShaderDad.contrast = -14;
			colorShaderDad.saturation = -21;
			colorShaderDad.hue = -22;

			// Исправлено: проверка на null перед использованием blend
			var topGlow = getNamedProp('topGlow');
			if (topGlow != null) {
				topGlow.blend = 0;
			}
		}

		if (FlxG.onMobile) {
			var bg = getNamedProp('bg');
			var evilTree = getNamedProp('evilTree');
			
			if (bg != null) bg.x += 90;
			if (evilTree != null) evilTree.x += 90;
		}
	}

	function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);

		if (save.data.spookyShaders != false) {
			if (getBoyfriend() != null && getBoyfriend().shader == null) {
				getBoyfriend().shader = colorShaderBf;
				var dad = getDad();
				if (dad != null) dad.shader = colorShaderDad;
			}
		} else {
			if (getBoyfriend() != null) {
				getBoyfriend().color = 0xFFA8B3;
				var dad = getDad();
				if (dad != null) dad.color = 0xFFA8B3;
			}
		}
	}

	override function onGameOver(event:ScriptEvent):Void {
		super.onGameOver(event);

		if (save.data.spookyShaders != false) {
			var boyfriend = getBoyfriend();
			if (boyfriend != null) boyfriend.shader = null;
		} else {
			var boyfriend = getBoyfriend();
			if (boyfriend != null) boyfriend.color = 0xFFFFFF;
		}
	}

	override function onSongRetry(event:ScriptEvent):Void {
		super.onSongRetry(event);

		if (save.data.spookyShaders != false) {
			var boyfriend = getBoyfriend();
			if (boyfriend != null) boyfriend.shader = colorShaderBf;
		} else {
			var boyfriend = getBoyfriend();
			if (boyfriend != null) boyfriend.color = 0xFFA8B3;
		}
	}
}